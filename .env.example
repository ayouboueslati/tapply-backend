# ─── Application DB (used by the app at runtime via tapply_app role) ──────────
DATABASE_URL=postgresql://tapply_app:changeme@localhost:5432/tapply

# ─── Test DB (isolated database for pytest) ───────────────────────────────────
# Must have migrations applied. Connect as a superuser so tests can SET ROLE.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tapply_test

# Clerk Auth Config
# Get this from your Clerk dashboard -> API Keys -> Secret key
CLERK_SECRET_KEY=


# ─── Migration DB (superuser — used by Alembic, NOT the app at runtime) ───────
# Set this in your shell or CI before running `alembic upgrade head`:
#   export MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tapply
# Alembic's env.py reads MIGRATION_DATABASE_URL if set, otherwise falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tapply
